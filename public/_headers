# Ubicación: public/_headers  (Cloudflare Pages / Workers static assets)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Assets con hash en el nombre (Astro): cachear "para siempre".
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fuentes self-hosted: mismo trato.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes: caché razonable (ajústalo si versionas los nombres).
/images/*
  Cache-Control: public, max-age=604800
