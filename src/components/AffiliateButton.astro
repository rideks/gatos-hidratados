---
import { ArrowUpRight } from "lucide-react";
const {
  href,
  productName,
  price,
  location = "product",
  label = "Ver precio en Amazon",
  full = false,
} = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="sponsored nofollow noopener"
  data-affiliate-location={location}
  data-product-name={productName}
  data-product-price={price}
  class:list={["btn btn-honey group/cta", full && "w-full"]}
>
  {label}
  <ArrowUpRight
    size={16}
    className="opacity-90 group-hover/cta:translate-x-0.5 group-hover/cta:-translate-y-0.5 transition-transform"
  />
</a>
<script is:inline>
  document.addEventListener("click", (e) => {
    const a = e.target.closest("a[data-affiliate-location]");
    if (!a || typeof window.gtag !== "function") return;
    window.gtag("event", "affiliate_click", {
      affiliate_location: a.dataset.affiliateLocation,
      product_name: a.dataset.productName,
      price: a.dataset.productPrice || null,
    });
  });
</script>
