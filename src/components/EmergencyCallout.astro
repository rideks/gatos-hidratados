---
// ============================================================================
// EmergencyCallout.astro — Aviso de URGENCIA veterinaria (YMYL).
//
// Bloque rojo, muy visible, para señales que exigen ir al veterinario ya.
// Reutilizable en guías de salud (urinario, renal, "no bebe"…).
//
// Uso:
//   <EmergencyCallout title="Cuándo es una urgencia (no esperes)">
//     <p>Si tu gato <strong>intenta orinar y no sale nada</strong>…</p>
//     <ul>…</ul>
//   </EmergencyCallout>
//
// El contenido va en el slot (prose-off): controla tú el markup interno.
// ============================================================================
import { AlertTriangle } from "lucide-react";

const { title = "Cuándo es una urgencia" } = Astro.props;
---

<aside
  class="not-prose my-6 rounded-xl border-2 border-red-300 bg-red-50 p-5"
  role="alert"
  aria-label={title}
>
  <p
    class="flex items-center gap-2 font-display font-bold text-red-800 text-base"
  >
    <AlertTriangle className="w-5 h-5 shrink-0" />
    {title}
  </p>
  <div
    class="mt-2 text-sm leading-relaxed text-red-900/90 [&_a]:font-semibold [&_a]:underline [&_strong]:font-semibold [&_ul]:mt-2 [&_ul]:space-y-1 [&_li]:ml-4 [&_li]:list-disc"
  >
    <slot />
  </div>
</aside>
