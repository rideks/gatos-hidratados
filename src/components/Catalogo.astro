---
import Layout from "../layouts/Layout.astro";
import HeaderApp from "../components/HeaderApp.astro";
import FooterApp from "../components/FooterApp.astro";
import PageHeader from "../components/PageHeader.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CatalogFilters from "../components/CatalogFilters.astro";
import { productos } from "../data/ProductData.js";

const breadcrumbs = [
  { name: "Inicio", path: "/" },
  { name: "Catálogo", path: "/catalogo/" },
];
---

<Layout
  title="Catálogo"
  description="Todos los productos que hemos analizado: fuentes de agua para gatos y filtros de recambio. Filtra por tipo, material, capacidad y características."
  canonical="/catalogo/"
>
  <HeaderApp />
  <PageHeader
    eyebrow="Todo"
    title="Catálogo"
    description="Todo lo que hemos analizado. Usa los filtros para acotar por tipo, material, capacidad o características."
  >
    <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  </PageHeader>

  <main class="max-w-6xl mx-auto px-4 py-12">
    <CatalogFilters products={productos} />
  </main>
  <FooterApp />
</Layout>
