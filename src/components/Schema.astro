---
// Inserta un bloque JSON-LD ya construido (objeto) en la página.
const { schema } = Astro.props;

// 📊 PRUEBA DE SCHEMAS — imprime el JSON-LD de cada página en la terminal
//    durante `npm run dev` o `npm run build`. Comenta este bloque para silenciar.
if (schema) {
  //console.log(`\n📊 [JSON-LD] ${Astro.url?.pathname ?? ""}`);
