---
import { ChevronRight } from "lucide-react";
const { items = [] } = Astro.props;
---

<nav aria-label="Migas de pan" class="text-sm text-ink-500">
  <ol class="flex flex-wrap items-center gap-1">
    {
      items.map((it, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <ChevronRight className="w-3.5 h-3.5 text-slate-400" />}
          {i < items.length - 1 ? (
            <a href={it.path} class="hover:text-brand-700">
              {it.name}
            </a>
          ) : (
            <span class="text-ink-700 font-medium">{it.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
