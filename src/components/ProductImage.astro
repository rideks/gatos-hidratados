---
import CatSilhouette from "./CatSilhouette.astro";
const { src, alt = "", loading = "lazy", pawSize = "w-12 h-12" } = Astro.props;
---
{src ? (
  <img src={src} alt={alt} loading={loading} class="w-full h-full object-cover" />
) : (
  <div class="w-full h-full flex flex-col items-center justify-center gap-1.5 bg-paper-200">
    <CatSilhouette class={`${pawSize} text-brand-300`} />
    <span class="u-data text-[0.6rem] tracking-widest uppercase text-brand-400/70">Foto en camino</span>
  </div>
)}
