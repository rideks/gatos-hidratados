---
import { getEditorialScore } from "../data/EditorialScores.js";
import { getMainImage } from "../utils/product.js";
import ProductImage from "./ProductImage.astro";
import AffiliateButton from "./AffiliateButton.astro";
import { BadgeCheck, Check } from "lucide-react";

const { products = [] } = Astro.props;
const pick = [...products]
  .map((p) => ({ p, s: getEditorialScore(p.slug)?.rating ?? 0 }))
  .sort((a, b) => b.s - a.s)[0]?.p;
const score = pick ? getEditorialScore(pick.slug)?.rating : null;
const pros = pick?.highlights?.pros?.slice(0, 3) || [];
const img = pick ? getMainImage(pick) : null;
---

{
  pick && (
    <div class="rounded-2xl bg-ink text-white p-6 md:p-8">
      <div class="flex items-center justify-between">
        <span class="kicker !text-brand-300 inline-flex items-center gap-1.5">
          <BadgeCheck className="w-3.5 h-3.5" /> Nuestra elección
        </span>
        <span class="inline-flex items-center gap-1 rounded-md btn-accent text-white text-xs font-semibold px-2.5 py-1">
          Selección Micifú
        </span>
      </div>
      <div class="grid sm:grid-cols-[200px_1fr] gap-6 mt-5 items-center">
        <a
          href={`/productos/${pick.slug}/`}
          class="block h-48 rounded-xl overflow-hidden border border-white/10 bg-white/5"
        >
          <ProductImage
            src={img}
            alt={pick.name}
            loading="eager"
            pawSize="w-14 h-14"
          />
        </a>
        <div>
          <p class="text-xs font-semibold text-brand-300 uppercase tracking-wide">
            {pick.brand}
          </p>
          <h3 class="font-display font-semibold text-white text-2xl md:text-[1.7rem] leading-tight mt-1">
            <a
              href={`/productos/${pick.slug}/`}
              class="hover:text-brand-200 transition-colors"
            >
              {pick.name}
            </a>
          </h3>
          <div class="flex items-center gap-3 mt-2">
            <span class="inline-flex items-center gap-1">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg
                  viewBox="0 0 24 24"
                  class="w-4 h-4"
                  fill={
                    i < Math.round(score) ? "#e0a340" : "rgba(255,255,255,.2)"
                  }
                  aria-hidden="true"
                >
                  <path d="M12 2l2.9 6.3 6.8.6-5.1 4.5 1.5 6.7L12 17.3 5.9 20.6l1.5-6.7-5.1-4.5 6.8-.6z" />
                </svg>
              ))}
            </span>
            <span class="u-data text-sm text-white/80">{score}/5</span>
          </div>
          <ul class="mt-3 space-y-1.5">
            {pros.map((pro) => (
              <li class="flex gap-2 text-sm text-white/85">
                <Check className="w-4 h-4 text-brand-300 mt-0.5 shrink-0" />
                {pro}
              </li>
            ))}
          </ul>
          <div class="flex items-center gap-4 flex-wrap mt-5">
            <span class="u-data text-2xl font-semibold text-white">
              {pick.price} €
            </span>
            <AffiliateButton
              href={pick.amazonUrl}
              productName={pick.name}
              price={pick.price}
              location="best-pick"
              label="Ver en Amazon"
            />
          </div>
        </div>
      </div>
    </div>
  )
}
