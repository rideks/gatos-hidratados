---
// Sellos de producto: distinguen CALIDAD analizada (Selección Micifú) de
// POPULARIDAD (Superventas). Un producto puede tener uno, otro, ambos o ninguno.
import { BadgeCheck, Flame } from "lucide-react";
const { product, class: cls = "" } = Astro.props;
const pick = product?.editorsPick;
const seller = product?.bestseller;
---
{(pick || seller) && (
  <span class:list={["inline-flex flex-wrap items-center gap-1.5", cls]}>
    {pick && (
      <span class="inline-flex items-center gap-1 rounded-md bg-brand-600 text-white text-[11px] font-semibold px-2 py-0.5 leading-none" title="Analizada y recomendada por calidad">
        <BadgeCheck className="w-3 h-3" /> Selección Micifú
      </span>
    )}
    {seller && (
      <span class="inline-flex items-center gap-1 rounded-md bg-amber-100 text-amber-800 border border-amber-200 text-[11px] font-semibold px-2 py-0.5 leading-none" title="De las más vendidas (popularidad)">
        <Flame className="w-3 h-3" /> Superventas
      </span>
    )}
  </span>
)}
