---
const LABELS = {
  material: "Material", capacity: "Capacidad", noise: "Ruido", pump: "Bomba",
  flow: "Caudal", filter: "Filtro", power: "Alimentación", cats: "Recomendada",
};
const { specs = {} } = Astro.props;
const rows = Object.entries(specs).filter(([, v]) => v && v !== "—");
---
{rows.length > 0 && (
  <div class="rounded-xl border border-brand-200 overflow-hidden">
    <div class="bg-brand-50 px-4 py-2.5 border-b border-brand-200 flex items-center gap-2">
      <span class="eyebrow !text-brand-700">Ficha técnica</span>
    </div>
    <dl class="divide-y divide-brand-100">
      {rows.map(([k, v]) => (
        <div class="grid grid-cols-3 gap-2 px-4 py-2.5 text-sm">
          <dt class="u-data text-xs text-brand-600 uppercase tracking-wide col-span-1 self-center">{LABELS[k] || k}</dt>
          <dd class="text-ink-700 col-span-2">{v}</dd>
        </div>
      ))}
    </dl>
  </div>
)}
