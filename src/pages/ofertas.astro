---
import Layout from "../layouts/Layout.astro";
import HeaderApp from "../components/HeaderApp.astro";
import FooterApp from "../components/FooterApp.astro";
import PageHeader from "../components/PageHeader.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ProductCard from "../components/ProductCard.astro";
import Schema from "../components/Schema.astro";
import { getDiscounted } from "../data/ProductData.js";
import { SITE } from "../config/site.js";
import { Tag } from "lucide-react";

const pct = (p) => {
  const price = Number(String(p.price).replace(",", ".")),
    orig = Number(String(p.originalPrice).replace(",", "."));
  return orig > price ? Math.round(((orig - price) / orig) * 100) : 0;
};
const ofertas = getDiscounted().sort((a, b) => pct(b) - pct(a));

const breadcrumbs = [
  { name: "Inicio", path: "/" },
  { name: "Ofertas", path: "/ofertas/" },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "CollectionPage", "@id": `${SITE.url}/ofertas/#webpage`, url: `${SITE.url}/ofertas/`, name: "Ofertas", description: "Fuentes de agua y accesorios para gatos con descuento.", inLanguage: "es-ES", isPartOf: { "@id": `${SITE.url}/#website` } },
    { "@type": "ItemList", numberOfItems: ofertas.length, itemListElement: ofertas.map((p, i) => ({ "@type": "ListItem", position: i + 1, name: p.name, url: `${SITE.url}/productos/${p.slug}/` })) },
  ],
};
---
<Layout title="Ofertas" description="Fuentes de agua para gatos y accesorios con descuento real, ordenados por el mayor ahorro." canonical="/ofertas/">
  <Schema schema={schema} />
  <HeaderApp />
  <PageHeader eyebrow="Chollos" title="Ofertas del momento" description="Productos con rebaja real, ordenados por el mayor descuento. Los precios finales se ven en Amazon.">
    <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  </PageHeader>

  <main class="max-w-6xl mx-auto px-4 py-12">
    {ofertas.length === 0 ? (
      <div class="text-center text-slate-500 py-16">
        <Tag className="w-8 h-8 mx-auto text-slate-300 mb-3" />
        <p>Ahora mismo no hay ofertas destacadas. Vuelve pronto.</p>
      </div>
    ) : (
      <>
        <p class="text-sm text-slate-500 mb-6">{ofertas.length} producto{ofertas.length === 1 ? "" : "s"} con descuento</p>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {ofertas.map((p) => <ProductCard product={p} />)}
        </div>
      </>
    )}
  </main>
  <FooterApp />
</Layout>
