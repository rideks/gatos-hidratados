import KeyFacts from "../components/KeyFacts.astro";
import VetDisclaimer from "../components/VetDisclaimer.astro";
import EmergencyCallout from "../components/EmergencyCallout.astro";
import Sources from "../components/Sources.astro";

const seo = {
  title:
    "Agua y problemas urinarios en gatos: cistitis, cristales y cuándo es urgencia",
  description:
    "Cómo influye la hidratación en las vías urinarias del gato (cistitis, cristales, FLUTD), qué dice de verdad la evidencia y las señales de urgencia que no debes ignorar.",
  canonical: "/agua-problemas-urinarios-gatos/",
};

const breadcrumbs = [
  { name: "Inicio", path: "/" },
  { name: "Hidratación", path: "/hidratacion-felina/" },
  { name: "Agua y problemas urinarios", path: seo.canonical },
];

const faqs = [
  {
    q: "¿Beber más agua cura la cistitis de mi gato?",
    a: "No es una cura, pero diluir la orina ayuda: una orina menos concentrada irrita menos la vejiga y reduce las recaídas de la cistitis idiopática, además de bajar el riesgo de cristales. La palanca mejor demostrada para conseguirlo es la comida húmeda, no la cantidad de agua que bebe por su cuenta. Siempre con el diagnóstico y el seguimiento de tu veterinario.",
  },
  {
    q: "¿Los cristales o piedras se disuelven bebiendo agua?",
    a: "Depende del tipo. Los de estruvita pueden disolverse con una dieta veterinaria específica; los de oxalato cálcico no se disuelven y a veces requieren cirugía. En ambos casos, más agua ayuda a prevenir su formación al diluir la orina, pero no sustituye al tratamiento que indique el veterinario.",
  },
  {
    q: "¿Una fuente de agua previene los problemas urinarios?",
    a: "Puede ayudar al gato que bebe más cuando el agua está en movimiento, pero la evidencia es mixta y una fuente no es un tratamiento. Para las vías urinarias pesan más la comida húmeda y el control del estrés. La fuente es una herramienta útil para el gato adecuado, no una solución médica.",
  },
  {
    q: "¿Cómo sé si es una urgencia?",
    a: "Si tu gato (sobre todo si es macho) intenta orinar y no sale nada o solo unas gotas, maúlla de dolor, se lame mucho la zona genital, está apático o vomita, ve al veterinario de inmediato: puede ser una obstrucción de la uretra, que es potencialmente mortal en 1-2 días.",
  },
];

// Fuentes citables (respaldan cifras y afirmaciones médicas de la guía).
const fuentes = [
  {
    authors: "International Cat Care (ISFM)",
    title: "Feline lower urinary tract disease (FLUTD)",
    source: "icatcare.org",
    url: "https://icatcare.org/articles/feline-lower-urinary-tract-disease",
  },
  {
    authors: "International Cat Care (ISFM)",
    title: "Urethral obstruction in cats",
    source: "icatcare.org",
    url: "https://icatcare.org/articles/urethral-obstruction-in-cats",
  },
  {
    authors: "International Cat Care (ISFM)",
    title: "Cistitis idiopática felina (FIC)",
    source: "icatcare.org",
    url: "https://icatcare.org/articles/feline-idiopathic-cystitis-fic-in-cats",
  },
  {
    authors: "American Veterinary Medical Association (AVMA)",
    title: "Feline lower urinary tract disease",
    source: "avma.org",
    url: "https://www.avma.org/resources-tools/pet-owners/petcare/feline-lower-urinary-tract-disease",
  },
  {
    authors: "Buckley CM, Hawthorne A, Colyer A, Stevenson AE",
    year: 2011,
    title:
      "Effect of dietary water intake on urinary output, specific gravity and relative supersaturation for calcium oxalate and struvite in the cat",
    source: "Br J Nutr 106(S1):S128-S130",
    url: "https://doi.org/10.1017/S0007114511001875",
  },
  {
    authors: "Taylor S, Boysen S, Buffington T, et al.",
    year: 2025,
    title:
      "iCatCare consensus guidelines on the diagnosis and management of lower urinary tract diseases in cats",
