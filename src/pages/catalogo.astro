---
import Layout from "../layouts/Layout.astro";
import HeaderApp from "../components/HeaderApp.astro";
import FooterApp from "../components/FooterApp.astro";
import PageHeader from "../components/PageHeader.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ProductCard from "../components/ProductCard.astro";
import { productos } from "../data/ProductData.js";
import { CATEGORIES } from "../data/taxonomy.js";

const breadcrumbs = [
  { name: "Inicio", path: "/" },
  { name: "Catálogo", path: "/catalogo/" },
];
const cats = CATEGORIES.map((c) => ({ id: c.id, name: c.name, items: productos.filter((p) => p.subcategory === c.id) })).filter((c) => c.items.length);
---
<Layout title="Catálogo" description="Todos los productos que hemos analizado: fuentes de agua para gatos y filtros de recambio, agrupados por categoría." canonical="/catalogo/">
  <HeaderApp />
  <PageHeader eyebrow="Todo" title="Catálogo" description="Todo lo que hemos analizado, agrupado por categoría.">
    <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />
  </PageHeader>

  <main class="max-w-6xl mx-auto px-4 py-12 space-y-14">
    {cats.map((c) => (
      <section>
        <h2 class="font-display font-extrabold text-ink text-2xl mb-6">{c.name}</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {c.items.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    ))}
  </main>
  <FooterApp />
</Layout>
