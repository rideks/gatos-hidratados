---
import Layout from "../../layouts/Layout.astro";
import HeaderApp from "../../components/HeaderApp.astro";
import FooterApp from "../../components/FooterApp.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Schema from "../../components/Schema.astro";
import ProductCard from "../../components/ProductCard.astro";
import TrustBanner from "../../components/TrustBanner.astro";
import { COMPARISONS, ENTITIES, getComparison } from "../../data/ComparativaData.js";
import { getBySubcategory } from "../../data/ProductData.js";
import { SITE } from "../../config/site.js";
import { buildWebPage, buildBreadcrumb, buildFaqPage, graph } from "../../utils/schema.js";
import { Check, X, Trophy, ArrowRight } from "lucide-react";

export function getStaticPaths() {
  return COMPARISONS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const a = ENTITIES[c.a];
const b = ENTITIES[c.b];
const canonical = `/comparativas/${c.slug}/`;
const url = new URL(canonical, SITE.url).href;
const related = c.subcategory ? getBySubcategory(c.subcategory).slice(0, 4) : [];

const breadcrumbs = [
  { name: "Inicio", path: "/" },
  { name: "Comparativas", path: "/comparativas/" },
  { name: `${a.name} vs ${b.name}`, path: canonical },
];

const schema = graph(
  buildWebPage({ url, name: c.seo.title, description: c.seo.description, breadcrumbId: `${url}#breadcrumb`, ...(c.faqs?.length && { mainEntityId: `${url}#faq` }) }),
  buildBreadcrumb(breadcrumbs, { id: `${url}#breadcrumb` }),
  c.faqs?.length ? buildFaqPage(c.faqs, { id: `${url}#faq` }) : null,
);
---
<Layout title={c.seo.title} description={c.seo.description} canonical={canonical} type="article">
  <Schema schema={schema} />
  <HeaderApp />

  <main class="max-w-3xl mx-auto px-4 pt-24 pb-16">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="font-display font-extrabold text-ink text-3xl sm:text-4xl mt-4 leading-tight">{c.seo.title}</h1>
    <p class="text-slate-600 mt-3">{c.seo.description}</p>

    <!-- Tabla comparativa -->
    <section class="mt-8 rounded-xl border border-brand-200 overflow-hidden">
      <div class="grid grid-cols-3 bg-slate-50 border-b border-brand-200 text-sm font-bold text-slate-700">
        <div class="p-3"></div>
        <div class="p-3 text-center">{a.name}</div>
        <div class="p-3 text-center">{b.name}</div>
      </div>
      {c.rows.map((row) => (
        <div class="grid grid-cols-3 border-b border-slate-100 last:border-0 text-sm">
          <div class="p-3 font-semibold text-slate-700">{row.label}</div>
          <div class:list={["p-3 text-center", row.winner === "a" && "font-bold text-brand-700"]}>
            {row.winner === "a" && <Check className="w-4 h-4 inline mr-1 text-green-600" />}{row.a}
          </div>
          <div class:list={["p-3 text-center", row.winner === "b" && "font-bold text-brand-700"]}>
            {row.winner === "b" && <Check className="w-4 h-4 inline mr-1 text-green-600" />}{row.b}
          </div>
        </div>
      ))}
    </section>

    <!-- Pros/contras de cada uno -->
    <section class="grid sm:grid-cols-2 gap-5 mt-10">
      {[a, b].map((ent) => (
        <div class="rounded-xl border border-brand-200 bg-white p-6">
          <p class="eyebrow">{ent.type === "marca" ? "Marca" : "Material"}</p>
          <h2 class="font-display font-extrabold text-ink text-xl mt-1">{ent.name}</h2>
          <p class="text-sm text-slate-600 mt-1">{ent.tagline}</p>
          <ul class="mt-4 space-y-1.5">
            {ent.pros.map((p) => <li class="flex gap-2 text-sm text-slate-700"><Check className="w-4 h-4 text-green-600 mt-0.5 shrink-0" />{p}</li>)}
            {ent.cons.map((con) => <li class="flex gap-2 text-sm text-slate-700"><X className="w-4 h-4 text-red-500 mt-0.5 shrink-0" />{con}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <!-- Veredicto -->
    <section class="mt-10 rounded-xl border border-brand-200 bg-brand-50 p-6">
      <p class="inline-flex items-center gap-2 eyebrow"><Trophy className="w-4 h-4" /> Veredicto</p>
      <p class="text-slate-800 mt-2">{c.verdict}</p>
    </section>

    {related.length > 0 && (
      <section class="mt-12">
        <h2 class="font-display font-extrabold text-ink text-2xl mb-5">Productos que hemos analizado</h2>
        <div class="grid gap-6 sm:grid-cols-2">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    )}

    {c.cta && (
      <a href={c.cta.path} class="group mt-8 flex items-center justify-between gap-3 rounded-xl border border-brand-200 bg-white p-5 hover:border-brand-300 hover:shadow-md transition-all">
        <span class="font-bold text-ink group-hover:text-brand-700">{c.cta.label}</span>
        <ArrowRight className="w-5 h-5 text-brand-600 group-hover:translate-x-0.5 transition-transform" />
      </a>
    )}

    {c.faqs?.length > 0 && (
      <section class="mt-12">
        <h2 class="font-display font-extrabold text-ink text-2xl mb-5">Preguntas frecuentes</h2>
        <div class="space-y-4">
          {c.faqs.map((f) => (
            <details class="rounded-xl border border-brand-200 p-4">
              <summary class="font-bold text-ink cursor-pointer">{f.q}</summary>
              <p class="text-slate-700 mt-2">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <div class="mt-12"><TrustBanner /></div>
  </main>
  <FooterApp />
</Layout>
