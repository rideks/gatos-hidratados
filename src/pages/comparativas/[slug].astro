---
import Layout from "../../layouts/Layout.astro";
import HeaderApp from "../../components/HeaderApp.astro";
import FooterApp from "../../components/FooterApp.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Schema from "../../components/Schema.astro";
import ProductCard from "../../components/ProductCard.astro";
import TrustBanner from "../../components/TrustBanner.astro";
import { COMPARISONS, ENTITIES } from "../../data/ComparativaData.js";
import { getBySubcategory } from "../../data/ProductData.js";
import { SITE } from "../../config/site.js";
import {
  buildWebPage,
  buildBreadcrumb,
  buildFaqPage,
  graph,
} from "../../utils/schema.js";
import { Check, X, Trophy, ArrowRight } from "lucide-react";

export function getStaticPaths() {
  return COMPARISONS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const a = ENTITIES[c.a];
const b = ENTITIES[c.b];
const canonical = `/comparativas/${c.slug}/`;
const url = new URL(canonical, SITE.url).href;

// Related: por marca si la comparativa define `brands`; si no, por subcategoría.
const related = c.subcategory
  ? (c.brands
      ? getBySubcategory(c.subcategory).filter((p) =>
          c.brands.includes(p.brand),
        )
      : getBySubcategory(c.subcategory)
    ).slice(0, 4)
  : [];

const breadcrumbs = [
  { name: "Inicio", path: "/" },
  { name: "Comparativas", path: "/comparativas/" },
  { name: `${a.name} vs ${b.name}`, path: canonical },
];

const schema = graph(
  buildWebPage({
    url,
    name: c.seo.title,
    description: c.seo.description,
    breadcrumbId: `${url}#breadcrumb`,
    ...(c.faqs?.length && { mainEntityId: `${url}#faq` }),
  }),
  buildBreadcrumb(breadcrumbs, { id: `${url}#breadcrumb` }),
  c.faqs?.length ? buildFaqPage(c.faqs, { id: `${url}#faq` }) : null,
);

const hasWinner = c.rows.some((r) => r.winner);
---

<Layout
  title={c.seo.title}
  description={c.seo.description}
  canonical={canonical}
  type="article"
>
  <Schema schema={schema} />
  <HeaderApp />

  <main class="max-w-3xl mx-auto px-4 pt-24 pb-16">
    <Breadcrumbs items={breadcrumbs} />
    <p class="eyebrow mt-4">
      {a.type === "marca" ? "Marca vs marca" : "Material vs material"}
    </p>
    <h1
      class="font-display font-semibold text-ink text-3xl sm:text-4xl mt-2 leading-tight tracking-tight"
    >
      {c.seo.title}
    </h1>
    <p class="text-ink-700 mt-3 leading-relaxed">{c.seo.description}</p>

    <!-- ── Comparativa por criterios (tarjetas) ──────────────────────────── -->
    <section class="mt-8">
      <!-- Los dos contendientes, fijos arriba -->
      <div class="grid grid-cols-2 gap-3">
        <div
          class="rounded-xl border border-line bg-surface px-4 py-3 text-center"
        >
          <p class="eyebrow">{a.type === "marca" ? "Marca" : "Material"}</p>
          <p class="font-display font-semibold text-ink mt-0.5 leading-tight">
            {a.name}
          </p>
        </div>
        <div
          class="rounded-xl border border-line bg-surface px-4 py-3 text-center"
        >
          <p class="eyebrow">{b.type === "marca" ? "Marca" : "Material"}</p>
          <p class="font-display font-semibold text-ink mt-0.5 leading-tight">
            {b.name}
          </p>
        </div>
      </div>

      <!-- Un criterio por tarjeta -->
      <div class="space-y-2.5 mt-3">
        {
          c.rows.map((row) => (
            <div class="rounded-xl border border-line bg-surface p-3 sm:p-4">
              <p class="text-[0.7rem] font-semibold uppercase tracking-wider text-ink-500 mb-2.5">
                {row.label}
              </p>
              <div class="grid grid-cols-2 gap-2.5">
                <div
                  class:list={[
                    "rounded-lg px-3 py-2.5 flex items-center justify-center gap-1.5 text-center text-sm leading-snug",
                    row.winner === "a"
                      ? "bg-brand-50 border border-brand-200 text-brand-700 font-semibold"
                      : "bg-paper-200/40 text-ink-700",
                  ]}
                >
                  {row.winner === "a" && (
                    <Check className="w-4 h-4 shrink-0 text-brand-600" />
                  )}
                  <span>{row.a}</span>
                </div>
                <div
                  class:list={[
                    "rounded-lg px-3 py-2.5 flex items-center justify-center gap-1.5 text-center text-sm leading-snug",
                    row.winner === "b"
                      ? "bg-brand-50 border border-brand-200 text-brand-700 font-semibold"
                      : "bg-paper-200/40 text-ink-700",
                  ]}
                >
                  {row.winner === "b" && (
                    <Check className="w-4 h-4 shrink-0 text-brand-600" />
                  )}
                  <span>{row.b}</span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>
    {
      hasWinner && (
        <p class="text-xs text-ink-500 mt-3 flex items-center gap-1.5">
          <Check className="w-3.5 h-3.5 text-brand-600" /> Marca nuestra
          preferencia en ese criterio.
        </p>
      )
    }
    {
      hasWinner && (
        <p class="text-xs text-ink-500 mt-2 flex items-center gap-1.5">
          <Check className="w-3.5 h-3.5 text-brand-600" /> Marca nuestra
          preferencia en ese criterio.
        </p>
      )
    }

    <!-- ── Pros / contras de cada uno ────────────────────────────────────── -->
    <section class="grid sm:grid-cols-2 gap-5 mt-10">
      {
        [a, b].map((ent) => (
          <div class="card p-6">
            <p class="eyebrow">{ent.type === "marca" ? "Marca" : "Material"}</p>
            <h2 class="font-display font-semibold text-ink text-xl mt-1">
              {ent.name}
            </h2>
            <p class="text-sm text-ink-700 mt-1 leading-relaxed">
              {ent.tagline}
            </p>

            <div class="mt-5 space-y-4">
              <div>
                <p class="text-[0.7rem] font-semibold uppercase tracking-wider text-brand-700 mb-2">
                  A favor
                </p>
                <ul class="space-y-2">
                  {ent.pros.map((p) => (
                    <li class="flex gap-2 text-sm text-ink-700">
                      <Check className="w-4 h-4 text-brand-600 mt-0.5 shrink-0" />
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="text-[0.7rem] font-semibold uppercase tracking-wider text-ink-500 mb-2">
                  En contra
                </p>
                <ul class="space-y-2">
                  {ent.cons.map((con) => (
                    <li class="flex gap-2 text-sm text-ink-700">
                      <X className="w-4 h-4 text-red-500 mt-0.5 shrink-0" />
                      <span>{con}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </section>

    <!-- ── Veredicto ─────────────────────────────────────────────────────── -->
    <section class="mt-10 rounded-xl border border-brand-200 bg-brand-50 p-6">
      <p class="eyebrow !text-brand-700 inline-flex items-center gap-2">
        <Trophy className="w-4 h-4" /> Veredicto
      </p>
      <p class="text-ink-700 mt-2 leading-relaxed">{c.verdict}</p>
    </section>

    <!-- ── CTA ───────────────────────────────────────────────────────────── -->
    {
      c.cta && (
        <a
          href={c.cta.path}
          class="group mt-8 flex items-center justify-between gap-3 rounded-xl border border-line bg-white p-5 hover:border-brand-300 hover:shadow-md transition-all"
        >
          <span class="font-semibold text-ink group-hover:text-brand-700">
            {c.cta.label}
          </span>
          <ArrowRight className="w-5 h-5 text-brand-600 group-hover:translate-x-0.5 transition-transform" />
        </a>
      )
    }

    <!-- ── Productos relacionados ────────────────────────────────────────── -->
    {
      related.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display font-semibold text-ink text-2xl mb-5">
            Productos que hemos analizado
          </h2>
          <div class="grid gap-6 sm:grid-cols-2">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </section>
      )
    }

    <!-- ── FAQ ───────────────────────────────────────────────────────────── -->
    {
      c.faqs?.length > 0 && (
        <section class="mt-12">
          <h2 class="font-display font-semibold text-ink text-2xl mb-5">
            Preguntas frecuentes
          </h2>
          <div class="space-y-3">
            {c.faqs.map((f) => (
              <details class="group rounded-xl border border-line bg-white p-4 open:border-brand-200 transition-colors">
                <summary class="font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-3">
                  {f.q}
                  <span class="text-brand-600 shrink-0 transition-transform group-open:rotate-45 text-xl leading-none">
                    +
                  </span>
                </summary>
                <p class="text-ink-700 mt-2 leading-relaxed">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <div class="mt-12"><TrustBanner /></div>
  </main>
  <FooterApp />
</Layout>
